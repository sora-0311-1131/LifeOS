# Supabase (Public / Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase (Server-only — NEVER prefix with NEXT_PUBLIC_)
# Used for Personal API Token issuance/verification and Bearer-authenticated Study APIs.
# For Supabase's new API keys, use the Secret key (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
